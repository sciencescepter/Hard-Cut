      "end": 155.45,
      "text": "\u0938\u094d\u0935\u093f\u091f \u0915\u094b\u0902"
    },
    {
      "start": 155.45,
      "end": 160.33,
      "text": "\u092e\u093e\u0928\u091a\u093e \u0909 \u0938\u0941\u092a"
    },
    {
      "start": 160.33,
      "end": 167.36,
      "text": "\u0924\u0915\u094d\u0938\u0940 \u092a\u094d\u0932\u093e\u091f\u0947 \u092a\u093f\u091f\u093e\u0907\u0924"
    },
    {
      "start": 167.36,
      "end": 168.36,
      "text": "\u0907\u0902\u091c\u0928 \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u093e\u0938"
    },
    {
      "start": 168.36,
      "end": 170.36,
      "text": "\u0938\u094d\u091f\u093e\u0930\u094d\u091f\u093e\u0938 \u092e\u093e\u092a\u0915\u094b \u0938\u092c \u092f\u0939 \u0938\u0947 \u092e\u093f\u0932\u094d\u0917\u093e\u0930"
    },
    {
      "start": 170.36,
      "end": 172.36,
      "text": "\u092e\u0938\u094d\u0930\u0941\u092e \u0924\u093f\u0915\u094d\u0915\u093e \u092a\u0928\u0947 \u0924\u093f\u0915\u094d\u0915\u093e"
    },
    {
      "start": 172.36,
      "end": 174.36,
      "text": "\u0932\u0938\u0941\u0928\u0940 \u092a\u0928\u0947 \u0924\u093f\u0915\u094d\u0915\u093e"
    },
    {
      "start": 208.52,
      "end": 209.52,
      "text": "\u0906\u092a \u091a\u0941\u0935\u094d\u0921\u093f\u092f\u093e"
    },
    {
      "start": 217.52,
      "end": 219.52,
      "text": "\u0924\u094b \u0926\u094b\u091c\u093c \u0915\u094b \u092f\u0947 \u092e\u094d\u0930\u0940 \u0924\u0947\u0935\u0932 \u092c\u093e\u091f\u0947"
    },
    {
      "start": 219.52,
      "end": 221.52,
      "text": "\u0924\u0940\u0915\u094d\u0915\u093e \u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902 \u0924\u094b \u0935\u093f\u0921\u093c\u093e \u0915\u094b \u0909\u0902\u0917\u094b\u0921\u093f\u0902\u0917 \u092a\u093e\u0938"
    },
    {
      "start": 221.52,
      "end": 223.52,
      "text": "\u091c\u0947\u0938\u0947 \u092e\u0947\u0902 \u092c\u0940 \u0905\u092a\u0928\u0947 \u092b\u094d\u0930\u0928\u0947 \u0915\u0947 \u0938\u093e\u091a\u094d\u091f\u093e\u0930\u094d\u091f\u093e \u0905\u0935\u093e\u0935\u091c\u093e"
    },
    {
      "start": 223.52,
      "end": 225.52,
      "text": "\u0935\u0939 \u092e\u0947\u0902 \u092a\u0947 \u091a\u093e\u091a\u094d\u091f\u0930\u094d\u091f\u0940\u0902 \u0906\u092a \u0936\u093f\u0917\u0921\u092c\u0930 \u0938\u093e\u091a\u094d\u091f\u0930\u094d\u091f\u093e \u0906\u092a\u0915\u093e"
    },
    {
      "start": 225.52,
      "end": 227.52,
      "text": "\u0905\u092b\u093c\u094d\u0930\u0947\u091c\u093f\u0903 \u092c\u0926\u094b\u0921\u093c\u0947 \u090f\u0902\u0917\u0947 \u0925\u0940\u0915\u0947"
