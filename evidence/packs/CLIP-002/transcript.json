    {
      "start": 297.06,
      "end": 303.62,
      "text": "\u0919\u0940 \u0935\u0940 \u092c\u0928\u093e \u0935\u094b\u0917\u093c\u093e"
    },
    {
      "start": 303.62,
      "end": 308.62,
      "text": "\u091c\u094b\u0902\u0924\u094d\u0930\u093eosexual"
    },
    {
      "start": 308.62,
      "end": 312.62,
      "text": "\u0915\u0947 \u0938\u094d verloren"
    },
    {
      "start": 312.62,
      "end": 328.86,
      "text": "\u0914\u0930 \u0935\u094b\u0917\u093c\u0947 \u0915\u093e\u092a\u094d\u091b\u0940 \u0924\u094b \u0915\u094b\u092a\u094d\u091d\u093e"
    },
