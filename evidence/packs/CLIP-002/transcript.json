  "model": "faster-whisper small",
  "segments": [
    {
      "start": 4.34,
      "end": 7.94,
      "text": "\u0906\u092a \u0906\u0901 \u0920\u093e\u0930 \u0928\u0939\u0940\u0902, \u0932\u091a\u094d\u091f\u0932\u094d\u091f\u093c\u093e\u092c \u0932\u094d\u092f\u0935\u093e\u091c\u093e \u0928\u0939\u0940\u0902, \u0924\u094b \u0935\u0948 \u0938\u0947 \u0925\u0947 \u0905\u0917\u0930 \u0932\u0917\u094d\u091f\u093e\u092c, \u0914\u0930 \u092d\u0940 \u0926\u0936\u093c\u092a \u092e\u0947\u0902\u0917\u093e \u0906\u092a \u0926\u093f\u0902\u0917, \u092a\u0930\u0921\u093b diyorum."
    },
    {
      "start": 7.94,
      "end": 10.06,
      "text": "\u0907\u0938 \u0938\u0930\u0924\u093f\u0938 \u0915\u0930 \u0918\u0930\u093e\u0928\u0940 \u092f\u0939\u0942\u0901\u0917, \u0905\u0930\u0947\u092e \u092c\u093e\u092a\u0915\u093e \u0932\u094c\u0926 \u092a\u0930 \u092f\u0939\u0942\u0901\u0909\u091d\u0947 \u0928\u0939\u0940\u0902, \u0924\u0940\u0917\u0947."
    },
    {
      "start": 10.06,
      "end": 20.14,
      "text": "\u0c06\u0c1f\u0c47 \u0c38\u0c48\u0c28\u0c69\u0c02\u0c05 \u0c32\u0c4f\u0c3e"
    },
    {
      "start": 24.92,
      "end": 38.0,
      "text": "sych apenasifa \u0c17\u0c3f\u0c28\u0c4d \u0c12\u0c4d\u0c32\u0c4d\u0c02 Nodew"
    },
    {
      "start": 38.0,
      "end": 45.6,
      "text": "\u092f\u093e\u091c\u093c\u093e \u091c\u092f \u0939\u0942\u0901"
    },
    {
      "start": 45.6,
      "end": 48.7,
      "text": "\u091f\u0942\u0936\u094d\u0924\u0947 \u092a\u0941\u0930\u093e \u0930\u0928\u092e\u0947 \u090f\u0921\u093e\u0928 \u092a\u0941\u0930\u093e \u0930\u0928\u094d\u092e\u0947 \u0915\u0940 \u0905\u0930\u094b \u092a\u094d\u0932\u0940\u0902"
    },
    {
      "start": 48.7,
      "end": 52.48,
      "text": "\u0907\u0938\u0915\u0947\u0902 \u0926\u0947\u0930 \u0905\u0935\u093e\u0930\u0947\u0964 \u0907\u0938\u0924\u0947 \u092f\u093e\u091c\u094d\u0920 \u0915\u0940 \u0905\u0928\u094d\u0924\u0930 \u0915\u0940 \u0905\u0930\u094d\u092d\u093e\u0928\u0947 \u0906\u093e\u0926."
    },
    {
      "start": 52.48,
      "end": 55.52,
      "text": "\u092f\u093e\u091c\u093c\u0947 \u092e\u0947\u0902, \u0924\u0942\u091d\u0940 \u0932\u0947\u0915 \u0935\u0917\u0947\u0930\u093e \u092a\u093e\u0928\u0940 \u0935\u093e\u0928\u0940 \u0939\u0948\u0964"
    },
    {
      "start": 55.52,
      "end": 122.22,
      "text": "\u0909\u0926\u094d\u0930\u0940\u0902\u0917 \u0930\u093e\u0917\u093e \u0906\u092a \u0915\u094b \u0905\u0928\u0915\u0940 \u092f\u093e\u0908 \u0906\u0902\u0924\u0930\u0940 \u0915\u0947 \u0905\u092a \u0932\u0941\u0917\u093e \u0938\u094d\u092a\u0935\u0936 \u0915\u094d\u0930\u0940 \u090f\u0915 \u092e\u0947\u0902\u0917\u093c\u093e \u092f\u093e\u0908 \u0932\u093f\u090f \u0930\u093e\u0917\u093e \u0915\u094b \u0905\u092a \u0930\u0939\u0940 \u0939\u0948 \u0925\u0947 \u091a\u094b\u0926\u092e \u0915\u0930 \u0932\u0917\u093e \u0935\u0939\u0917\u093c\u093e \u0938\u094d\u092b\u094b\u0921\u094d\u0924\u093e \u0915\u094d\u0930\u0940 \u0905\u0928\u094d\u092a\u094b\u0917\u093c \u0906\u0902\u091f\u0930 \u0915\u0947 \u0906\u092c \u0930\u093e\u0917\u093e \u0905\u092a \u0915\u0940 \u0905\u0901\u092d\u093c\u093e \u0913 \u0905\u092a \u0938\u094d\u092b\u0939\u0940 \u0915\u094d\u0930\u091f\u093e \u0906\u092a \u0909\u0917\u0930 \u0906\u0902\u0926\u0930 \u0915\u0940 \u0905\u092c"
    },
    {
      "start": 122.22,
      "end": 127.95,
      "text": "\u0906\u0908 \u0907\u0938\u0915\u093e \u0906\u0908 \u0916\u0941\u091b \u0906\u092a \u0938\u0947 \u092f\u0939\u093e\u0901 \u0938\u0947 \u0905\u0902\u0925\u0930 \u0926\u0947\u0916"
    },
    {
      "start": 127.95,
      "end": 129.95,
      "text": "\u0905\u092b\u094b\u091c\u093c"
    },
    {
      "start": 129.95,
      "end": 131.95,
      "text": "\u091c\u0947\u0930"
    },
    {
      "start": 131.95,
      "end": 133.95,
      "text": "\u092c\u0938 \u0916\u094d\u0932\u093e\u0938"
    },
    {
      "start": 141.47,
      "end": 143.47,
      "text": "\u091c\u094b \u0926\u094b\u091a \u0925\u094b \u092f\u0939 \u0906\u0908 \u0906\u0916\u093e \u092e\u0948\u0928\u0942 \u0939\u0948"
    },
    {
      "start": 143.47,
      "end": 145.47,
      "text": "\u092f\u0939 \u091f\u0940\u0916 \u0939\u0948, \u0907\u0928 \u092b\u094d\u0932\u094d\u091f \u092e\u0948\u0928\u0942"
    },
    {
