    {
      "start": 287.86,
      "end": 292.06,
      "text": "\u092c\u094b\u0938\u0935\u0947 \u092c\u094d\u0930\u0947\u0935\u0940 \u092a\u093e\u0924\u094d\u092e\u093e \u0938\u0947 \u0916\u0947\u0937\u094d\u0938\u091f\u093e\u093c."
    },
    {
