      "start": 227.52,
      "end": 229.52,
      "text": "\u0905\u092b\u093c\u0921\u0930 \u092d\u0940 \u0906\u0928\u0947 \u092f\u093e\u0921\u093c\u093e"
    },
    {
      "start": 229.52,
      "end": 231.52,
      "text": "\u092c\u0940\u090a\u0938 \u092e\u0940\u091f \u092c\u094b\u0921\u093e\u090f \u0928\u094b\u0902\u0917\u0947"
    },
    {
      "start": 231.52,
      "end": 233.52,
      "text": "\u0926\u0947\u0916 \u0926\u0947\u0916 \u0938\u092c \u092c\u0940 \u092a\u093e\u0901\u091c \u092e\u0940\u091f \u091b\u094b\u091f\u094d\u092f\u093e\u0917\u093c \u0932\u0947\u0915\u094d\u0937\u0940 \u0915\u094d\u0924\u0921\u093e\u090f"
    },
    {
      "start": 233.52,
      "end": 235.52,
      "text": "\u0924\u094b \u0905\u092b\u093c\u0928\u0947 \u090f\u0926\u093c \u0930\u093e\u091a\u0922\u0940\u092a\u0930\u0917\u0917"
    },
    {
      "start": 235.52,
      "end": 237.52,
      "text": "\u091c\u0930 \u092d\u0940 \u0914\u0930 \u0938\u094b\u0926\u093c\u0930 \u092d\u0940 \u0906\u0928\u0947 \u092f\u093e\u0921\u093c\u093e"
    },
    {
      "start": 237.52,
      "end": 241.62,
      "text": "\u091c\u094b \u0938\u094d\u0935\u093f\u0932\u094d\u0924\u0930\u0915\u0947 \u0930 brigie"
    },
    {
      "start": 243.92,
      "end": 247.12,
      "text": "\u091a\u0921\u093c \u0938\u094d\u092e\u0947\u0932\u0947 \u092c \ufffd railroad"
    },
    {
      "start": 252.12,
      "end": 256.02,
      "text": "dua"
    },
    {
      "start": 259.72,
      "end": 261.22,
      "text": "\u0926\u0947\u0917 \u0915\u0930\u092b\u0940 \u0928\u0947 \u0915\u0930\u0938\u0940 \u0915\u093e\u091b\u0948 \ufffd frequently"
    },
    {
      "start": 262.22,
      "end": 263.42,
      "text": "\u0915\u0941\u0901\u0930\u0947"
    },
    {
      "start": 264.22,
      "end": 265.22,
      "text": "\u0915\u0941\u0901\u0930\u0947"
    },
    {
      "start": 266.22,
      "end": 266.48,
      "text": "6"
    },
    {
      "start": 266.48,
      "end": 271.62,
      "text": "\u0906\u092f\u093e \u092f\u0939 \u092f\u0939 \u0924\u093f\u0915\u094d\u0939 \u0915\u0947 \u0939\u094b\u0917\u0940 \u090f\u0938\u0915\u0947 \u090f\u0928 \u0924\u0930 \u0914\u0917 \u0935\u0947 \u0935\u0947 \u0935\u0947 \u0915\u0926\u093c."
    },
    {
      "start": 272.0,
      "end": 273.52,
      "text": "\u0909\u0930\u0947 \u0907\u0924\u0947 \u0924\u0947\u091a \u0924\u0947\u0936\u093e \u0925\u0947 \u0939\u0948\u0902."
    },
    {
      "start": 274.9,
      "end": 277.36,
      "text": "\u0936\u0941\u0932\u094b \u0926\u0942\u0901\u0938 \u0924\u094b \u092d\u0940 \u0905\u092a\u0928\u093e \u091a\u0940\u0938 \u092c\u0930 \u091c\u0926\u093e \u090f\u091a\u094d\u091b\u0942\u0916\u093e \u0928\u0947 \u0924\u0947\u091a \u0915\u0930 \u0924\u094b."
    },
    {
      "start": 277.36,
      "end": 278.18,
      "text": "\u0915\u094d\u092f\u093e \u0938\u093e \u0939\u0948\u0938\u0942\u090f?"
